{
  "expo": {
    "name": "İlaç Hatırlatıcı",
    "slug": "dad-medicine",
    "version": "1.0.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dadmedicine",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.macallan.dadmedicine",
      "allowBackup": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "backgroundColor": "#145DA8",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "./plugins/withAndroidKotlinPackage",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a2b40e2-4c7d-4847-a1b2-a866e819855d"
      }
    }
  }
}
